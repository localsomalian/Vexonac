{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "cross-env NODE_ENV=development bun run --hot src/index.ts",
    "dev:node": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "start": "bun run dist/src/index.js",
    "start:node": "node dist/src/index.js",
    "db:push": "dotenv -e .env.development prisma db push --schema ../../packages/database/prisma/schema.prisma --force-reset",
    "db:studio": "dotenv -e .env.development prisma studio --schema ../../packages/database/prisma/schema.prisma",
    "db:generate": "dotenv -e .env.development prisma generate --schema ../../packages/database/prisma/schema.prisma",
    "db:migrate": "dotenv -e .env.development prisma migrate dev --schema ../../packages/database/prisma/schema.prisma",
    "db:reset": "dotenv -e .env.development prisma migrate reset --schema ../../packages/database/prisma/schema.prisma"
  },
  "prisma": {
    "schema": "../../packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@polar-sh/sdk": "^0.41.5",
    "@prisma/extension-accelerate": "^1.3.0",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@vexonac/config": "*",
    "@vexonac/database": "*",
    "@vexonac/types": "*",
    "@vexonac/utils": "*",
    "better-auth": "^1.6.11",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "discord.js": "^14.19.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.1.5",
    "node-cron": "^3.0.3",
    "resend": "^4.6.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.0.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "tsc-alias": "^1.8.11",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2"
  }
}
