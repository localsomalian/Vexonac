{
  "name": "ingress-api",
  "version": "1.0.0",
  "description": "FiveM server ingress API with WebSocket and Redis support",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development bun run --hot src/index.ts",
    "dev:node": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc && tsc-alias && npm run copy-assets",
    "copy-assets": "cpx \"assets/**/*\" dist/assets --include-empty-dirs",
    "start": "bun run dist/index.js",
    "start:node": "node dist/index.js",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@vexonac/database": "*",
    "@vexonac/types": "*",
    "@vexonac/utils": "*",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.4",
    "winston": "^3.11.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "cpx": "^1.5.0",
    "cross-env": "^10.1.0",
    "tsc-alias": "^1.8.11",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2"
  },
  "prisma": {
    "schema": "../../packages/database/prisma/schema.prisma"
  }
}
