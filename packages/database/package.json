{
  "name": "@vexonac/database",
  "version": "0.0.0",
  "description": "Shared database schema and client for VexonAC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "generate": "prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.9.0",
    "@prisma/extension-accelerate": "^1.3.0",
    "@prisma/extension-optimize": "^1.1.8"
  },
  "devDependencies": {
    "prisma": "6.9.0",
    "typescript": "^5.8.2",
    "tsx": "^4.7.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
