{
  "server-page": {
    "scope": "typescript,typescriptreact",
    "prefix": "serverpage",
    "body": [
      "\"use client\";",
      "import { ContentLayout } from \"@/components/content-layout\";",
      "import { formatServerName } from \"@/components/format-server-name\";",
      "import { authClient } from \"@/lib/auth-client\";",
      "import { trpc } from \"@/utils/trpc\";",
      "import { useQuery } from \"@tanstack/react-query\";",
      "import { useParams } from \"next/navigation\";",
      "",
      "export default function Server${1:PageName}() {",
      "  const params = useParams();",
      "  const serverId = params.serverId as string;",
      "  const { data: session } = authClient.useSession();",
      "",
      "  const { data: server, isLoading } = useQuery(",
      "    trpc.servers.getServer.queryOptions(serverId, {",
      "      enabled: !!session?.user,",
      "    })",
      "  );",
      "",
      "  return (",
      "    <ContentLayout",
      "      title={formatServerName(server?.serverName || \"${1:PageName} Dashboard\")}",
      "      breadcrumb={{ title: \"Dashboard\", url: `/dashboard/server/${serverId}` }}",
      "    >",
      "      {isLoading ? (",
      "        <div className=\"flex items-center justify-center p-8\">",
      "          <div className=\"h-8 w-8 animate-spin rounded-full border-b-2 border-t-2 border-primary\"></div>",
      "        </div>",
      "      ) : (",
      "        <div className=\"grid gap-6\">",
      "          {/* ${1:PageName} content goes here */}",
      "        </div>",
      "      )}",
      "    </ContentLayout>",
      "  );",
      "}"
    ],
    "description": "Create a Server Dashboard page component"
  }
}
